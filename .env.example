# Copy to .env locally; server.py and migrate_sqlite.py load it automatically.
# Existing process environment variables take precedence. Never commit actual values.
# Neon Console > Connect: copy the FULL URL including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ENV=production
APP_AUTH_REQUIRED=0
# Optional: set APP_AUTH_REQUIRED=1 and supply an Argon2 hash to enable login.
APP_PASSWORD_HASH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
COOKIE_SECURE=1
HOST=0.0.0.0
JLPT_NO_BROWSER=1
# Local HTTP authentication testing ONLY: APP_ENV=development COOKIE_SECURE=0
