# Copy to .env locally and load it explicitly; never commit actual values.
# Neon Console > Connect: copy the FULL URL including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ENV=production
APP_PASSWORD_HASH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
COOKIE_SECURE=1
HOST=0.0.0.0
JLPT_NO_BROWSER=1
# Local HTTP authentication testing ONLY: APP_ENV=development COOKIE_SECURE=0
